generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  SENIOR_ADMIN
  ADMIN
  JUNIOR_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ThemePref {
  SYSTEM
  LIGHT
  DARK
}

enum ProjectCategory {
  GITHUB
  TELEGRAM_BOT
  DJANGO
  WEB_APP
  OTHER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum ExperienceType {
  EXPERIENCE
  EDUCATION
  CERTIFICATION
  ACHIEVEMENT
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

model User {
  id             Int        @id @default(autoincrement())
  username       String     @unique
  email          String     @unique
  displayName    String     @default("")
  bio            String     @default("")
  passwordHash   String
  role           Role       @default(JUNIOR_ADMIN)
  status         UserStatus @default(ACTIVE)
  preferredTheme ThemePref  @default(SYSTEM)
  githubUrl      String     @default("")
  telegramUrl    String     @default("")
  avatarId       Int?
  avatar         Media?     @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  sessionVersion Int        @default(0)
  failedLogins   Int        @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdById    Int?
  createdBy      User?      @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers   User[]     @relation("UserCreator")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  uploads      Media[]      @relation("MediaUploader")
  vaultEntries VaultEntry[]
  auditLogs    AuditLog[]

  @@index([role])
}

model Media {
  id           Int      @id @default(autoincrement())
  filename     String
  mimeType     String
  size         Int
  alt          String   @default("")
  data         Bytes
  uploadedById Int?
  uploadedBy   User?    @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  avatarOf User[]    @relation("UserAvatar")
  covers   Project[] @relation("ProjectCover")
}

model Project {
  id          Int             @id @default(autoincrement())
  title       String
  description String          @default("")
  coverId     Int?
  cover       Media?          @relation("ProjectCover", fields: [coverId], references: [id], onDelete: SetNull)
  galleryIds  Int[]
  techStack   String[]
  category    ProjectCategory @default(OTHER)
  githubUrl   String          @default("")
  liveUrl     String          @default("")
  featured    Boolean         @default(false)
  status      PublishStatus   @default(DRAFT)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, sortOrder])
  @@index([category])
}

model Skill {
  id          Int      @id @default(autoincrement())
  name        String
  category    String   @default("General")
  description String   @default("")
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible, sortOrder])
}

model Experience {
  id           Int            @id @default(autoincrement())
  type         ExperienceType @default(EXPERIENCE)
  title        String
  organization String         @default("")
  startDate    String         @default("")
  endDate      String         @default("")
  description  String         @default("")
  sortOrder    Int            @default(0)
  visible      Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([type, sortOrder])
}

model SocialLink {
  id        Int      @id @default(autoincrement())
  label     String
  url       String
  icon      String   @default("link")
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  subject   String        @default("")
  message   String
  ipHash    String        @default("")
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

// Kept apart from public portfolio data. Secrets are stored only as AES-256-GCM ciphertext.
model VaultEntry {
  id          Int      @id @default(autoincrement())
  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  service     String
  username    String   @default("")
  url         String   @default("")
  category    String   @default("General")
  passwordEnc String
  notesEnc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, service])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Table used by connect-pg-simple (express-session store).
model Session {
  sid    String   @id
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
