<section class="auth-card">
  <a class="brand" href="/"><span class="brand-mark"><%- icon('lock', 18) %></span><span class="brand-name">Sign in</span></a>
  <p class="muted">Administrator access only.</p>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/login" class="stack" data-loading>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label class="field"><span>Username or email</span><input class="input" name="identifier" value="<%= identifier %>" autocomplete="username" required autofocus maxlength="254"></label>
    <label class="field"><span>Password</span><input class="input" type="password" name="password" autocomplete="current-password" required maxlength="200"></label>
    <button class="btn btn-primary btn-block" type="submit"><span class="spin" aria-hidden="true"></span>Sign in</button>
  </form>
</section>
