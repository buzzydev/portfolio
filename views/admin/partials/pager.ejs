<% if (pages > 1) { var qs = function (p) { var o = Object.assign({}, query || {}, { page: p }); return '?' + Object.keys(o).filter(function (k) { return o[k] !== '' && o[k] != null; }).map(function (k) { return encodeURIComponent(k) + '=' + encodeURIComponent(o[k]); }).join('&'); }; %>
<nav class="pager" aria-label="Pagination">
  <a class="btn btn-ghost btn-sm <%= page <= 1 ? 'is-disabled' : '' %>" href="<%= qs(Math.max(1, page - 1)) %>" <%= page <= 1 ? 'aria-disabled=true tabindex=-1' : '' %>>Previous</a>
  <span class="muted">Page <%= page %> of <%= pages %></span>
  <a class="btn btn-ghost btn-sm <%= page >= pages ? 'is-disabled' : '' %>" href="<%= qs(Math.min(pages, page + 1)) %>" <%= page >= pages ? 'aria-disabled=true tabindex=-1' : '' %>>Next</a>
</nav>
<% } %>
