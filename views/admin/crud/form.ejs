<div class="page-head"><div><h1><%= item ? 'Edit ' + cfg.singular : 'New ' + cfg.singular %></h1></div></div>
<form class="card stack form-wide" method="post" action="<%= action %>" data-loading>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% if (Object.keys(errors).length) { %><div class="alert alert-error" role="alert">Fix the highlighted fields and save again.</div><% } %>
  <%- include('../partials/fields') %>
  <div class="form-actions"><a class="btn btn-ghost" href="<%= base %>">Cancel</a><button class="btn btn-primary" type="submit"><span class="spin" aria-hidden="true"></span>Save <%= cfg.singular %></button></div>
</form>
